# The tilefish C and C++ host, installed: tilefish::tilefish (libtilefish_capi, shared) and tilefish::tilefish_static, with tilefish.h and
# tilefish.hpp on their include path.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

set_and_check(tilefish_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(tilefish_LIB_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

if(NOT TARGET tilefish::tilefish)
    add_library(tilefish::tilefish SHARED IMPORTED)
    set_target_properties(tilefish::tilefish PROPERTIES
        IMPORTED_LOCATION "${tilefish_LIB_DIR}/@tilefish_shared_file@"
        INTERFACE_INCLUDE_DIRECTORIES "${tilefish_INCLUDE_DIR}")
    if(APPLE)
        set_target_properties(tilefish::tilefish PROPERTIES IMPORTED_SONAME "@rpath/libtilefish_capi.dylib")
    else()
        set_target_properties(tilefish::tilefish PROPERTIES IMPORTED_SONAME "@tilefish_shared_file@")
    endif()
    add_library(tilefish::tilefish_shared ALIAS tilefish::tilefish)

    add_library(tilefish::tilefish_static STATIC IMPORTED)
    set_target_properties(tilefish::tilefish_static PROPERTIES
        IMPORTED_LOCATION "${tilefish_LIB_DIR}/libtilefish_capi.a"
        INTERFACE_INCLUDE_DIRECTORIES "${tilefish_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES "Threads::Threads;@tilefish_static_libs@")
endif()

check_required_components(tilefish)
