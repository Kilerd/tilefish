//
// y[r, c] = x[r * x_s0 + c] for r < gridDim.x, c < cols: copies the bf16 elements of a strided view into a dense tensor; written by hand.
// One block per row; the threads of a block stride over the columns. The row stride is a 64-bit element count.
// C ABI: (const unsigned short* x, unsigned short* y, unsigned int cols, unsigned long long x_s0). No Triton scratch slots.
//
.version 7.0
.target sm_80
.address_size 64

.visible .entry strided_copy_bf16(
	.param .u64 x,
	.param .u64 y,
	.param .u32 cols,
	.param .u64 x_s0
)
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<5>;
	.reg .b16 	%h<2>;
	.reg .b64 	%rd<12>;

	ld.param.u64 	%rd1, [x];
	ld.param.u64 	%rd2, [y];
	ld.param.u32 	%r1, [cols];
	ld.param.u64 	%rd3, [x_s0];
	mov.u32 	%r2, %ctaid.x;
	mov.u32 	%r3, %tid.x;
	mov.u32 	%r4, %ntid.x;
	cvt.u64.u32 	%rd4, %r2;
	mul.lo.u64 	%rd5, %rd4, %rd3;
	cvt.u64.u32 	%rd6, %r1;
	mul.lo.u64 	%rd7, %rd4, %rd6;
LOOP:
	setp.ge.u32 	%p1, %r3, %r1;
	@%p1 bra 	DONE;
	cvt.u64.u32 	%rd8, %r3;
	add.u64 	%rd9, %rd5, %rd8;
	shl.b64 	%rd9, %rd9, 1;
	add.u64 	%rd9, %rd1, %rd9;
	add.u64 	%rd10, %rd7, %rd8;
	shl.b64 	%rd10, %rd10, 1;
	add.u64 	%rd10, %rd2, %rd10;
	ld.global.b16 	%h1, [%rd9];
	st.global.b16 	[%rd10], %h1;
	add.u32 	%r3, %r3, %r4;
	bra.uni 	LOOP;
DONE:
	ret;
}
